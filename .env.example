# 复制这个文件，改名为 .env，填上自己的密钥（.env 不会提交到 Git）

# DeepSeek 大模型（必填才能用 AI 功能）：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 飞书群机器人 Webhook（选填，用于推送周报）
FEISHU_WEBHOOK=

# 向量模型（选填，填了智能客服会用“关键词 + 向量”混合检索），例如硅基流动的 BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# DuckDB 可用内存（电脑内存小可以调低）
DUCKDB_MEMORY_LIMIT=4GB
